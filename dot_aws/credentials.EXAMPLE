# old staging
[xyz]
mfa_serial=arn:aws:iam::1111111111111:mfa/FIXME
aws_mfa_device = arn:aws:iam::1111111111111:mfa/FIXME
AWS_ACCESS_KEY_ID = 
AWS_SECRET_ACCESS_KEY = 
region = us-west-2
output = json


# new staging
[xyz-staging]
mfa_serial = arn:aws:iam::1111111111111:mfa/FIXME-staging
aws_mfa_device = arn:aws:iam::1111111111111:mfa/FIXME-staging
aws_access_key_id =
aws_secret_access_key =
region = us-east-2
output = json


# NOTE, it's recomended to keep PROD in separate file (encrypted)
[xyz-prod]
mfa_serial = arn:aws:iam::1111111111111:mfa/FIXME-prod
aws_mfa_device = arn:aws:iam::1111111111111:mfa/FIXME-prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
region = us-east-2
output = json



